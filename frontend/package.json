{
  "name": "eventsbooking-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "node scripts/vitest.mjs run",
    "test:watch": "node scripts/vitest.mjs",
    "typecheck": "tsc --noEmit",
    "api:types": "openapi-typescript ../docs/openapi.json -o src/api/schema.d.ts",
    "api:types:live": "openapi-typescript http://localhost:8080/v3/api-docs -o src/api/schema.d.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.108.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.6",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^31.0.1",
    "openapi-typescript": "^7.13.0",
    "typescript": "~5.9",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
